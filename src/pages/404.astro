---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="404 Not Found | Kattyan"
  description="ページが見つかりません"
>
  <div class="flex flex-col items-center text-center py-24 space-y-6 animate-fade-up">
    <p class="text-8xl font-extrabold tracking-tight text-muted-foreground/40">
      404
    </p>
    <div class="space-y-2">
      <h1 class="text-3xl font-bold">Page Not Found</h1>
      <p class="text-muted-foreground">
        お探しのページは移動または削除された可能性があります。
      </p>
    </div>
    <div class="flex gap-4">
      <a
        href="/"
        class="px-4 py-2 rounded-md bg-primary text-primary-foreground hover:bg-primary/90 transition-colors"
      >
        ホームへ戻る
      </a>
      <a
        href="/blog"
        class="px-4 py-2 rounded-md border hover:bg-muted transition-colors"
      >
        ブログを見る
      </a>
    </div>
  </div>
</BaseLayout>
