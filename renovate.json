{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:js-app",
    ":semanticCommits",
    "helpers:pinGitHubActionDigests"
  ],
  "labels": ["dependencies"],
  "packageRules": [
    {
      "groupName": "astro packages",
      "groupSlug": "astro",
      "matchPackageNames": ["/^@astrojs/", "/^astro$/"]
    },
    {
      "groupName": "oxc packages",
      "groupSlug": "oxc",
      "matchPackageNames": ["oxlint", "oxfmt", "@astrojs/compiler-rs"]
    },
    {
      "groupName": "textlint packages",
      "groupSlug": "textlint",
      "matchPackageNames": ["/^textlint/"]
    },
    {
      "groupName": "tailwind packages",
      "groupSlug": "tailwind",
      "matchPackageNames": ["/^@tailwindcss/", "/^tailwindcss$/"]
    },
    {
      "groupName": "rehype packages",
      "groupSlug": "rehype",
      "matchPackageNames": ["/^rehype-/"]
    },
    {
      "groupName": "remark packages",
      "groupSlug": "remark",
      "matchPackageNames": ["/^remark-/"]
    },
    {
      "matchPackageNames": ["katex", "rehype-katex"],
      "groupName": "katex packages",
      "groupSlug": "katex"
    },
    {
      "matchPackageNames": ["shiki", "sharp"],
      "groupName": "image processing and syntax highlighting",
      "groupSlug": "image-syntax"
    },
    {
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["patch", "minor"],
      "groupName": "dev dependencies (non-major)"
    },
    {
      "description": "minor・patch などの非破壊的な更新は CI が通れば自動マージする",
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true
    },
    {
      "description": "0.x の minor 更新は semver 上破壊的変更を含みうるので手動でマージする",
      "matchUpdateTypes": ["minor"],
      "matchCurrentVersion": "/^0\\./",
      "automerge": false
    },
    {
      "matchUpdateTypes": ["major"],
      "automerge": false
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["* * * * 1"]
  },
  "vulnerabilityAlerts": {
    "minimumReleaseAge": null
  },
  "osvVulnerabilityAlerts": true,
  "timezone": "Asia/Tokyo",
  "dependencyDashboard": true,
  "rangeStrategy": "pin",
  "prCreation": "not-pending",
  "minimumReleaseAge": "7 days",
  "platformAutomerge": true
}
